{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "echo \"Static Costa Blanca Tours site is ready in public/\"",
    "start": "echo \"Static site: serve public/ via Vercel\"",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\""
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
